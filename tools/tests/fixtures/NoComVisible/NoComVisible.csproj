<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- A web app, where CA1017 fires (the web SDK gives the assembly a public type), without the kit's ComVisible(false). -->
  <ItemGroup>
    <AssemblyAttribute Remove="System.Runtime.InteropServices.ComVisibleAttribute" />
  </ItemGroup>

</Project>
