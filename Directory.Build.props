<Project>

  <!-- Language and compiler strictness. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- TreatWarningsAsErrors covers compiler and NuGet warnings; this covers warnings from MSBuild tasks too. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Analyzers: every rule on (latest-all, plus the root .globalconfig for the rules it leaves off), and code style (IDExxxx) enforced on command-line builds, not only in the IDE. -->
  <PropertyGroup>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- XML documentation on every publicly visible member (STY-008): with a documentation file, the compiler reports
       CS1591 for each one that has no comment, and STY-004 makes it an error. Test projects (names ending in Tests) are
       left out: their public members are test classes no one calls (ADR-0069). So is the project BenchmarkDotNet
       generates for each run, BenchmarkDotNet.Autogenerated: it asks not to import this file, but sets that too late, so it
       gets these settings (dotnet/BenchmarkDotNet#2722, closed as a duplicate, not fixed in 0.15.8), and its generated
       code has no comments. Drop that part of the condition once a BenchmarkDotNet release fixes the import. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests')) and '$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Every assembly says COM can't see its types, which CA1017 asks for (STY-003, ADR-0043). A type that COM must
       see says so itself with [ComVisible(true)]. A project that already declares an assembly-level ComVisible
       (error CS0579, duplicate attribute) removes this one with
       <AssemblyAttribute Remove="System.Runtime.InteropServices.ComVisibleAttribute" />. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Every assembly says it isn't CLS-compliant, which CA1014 asks for: Microsoft's CA1014 page says to apply the
       attribute with false rather than suppress the rule (STY-003, ADR-0049). An app's assemblies aren't libraries
       other .NET languages consume, and ASP.NET Core and EF Core don't declare CLS compliance either. A library published
       for other languages removes this with <AssemblyAttribute Remove="System.CLSCompliantAttribute" /> and declares
       [assembly: CLSCompliant(true)], so the compiler checks it. A project that declares the attribute itself gets
       CS0579 (a duplicate attribute) and removes this item the same way. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Craft checks (ADR-0043): .globalconfig turns the metric rules on and CodeMetricsConfig.txt sets their limits
       (CRF-008); BannedSymbols.txt lists the APIs the banned-API analyzer rejects (CRF-010). -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- Pure assemblies (ARC-008, ADR-0080): a project that sets <PureAssembly>true</PureAssembly> in its .csproj also gets
       BannedSymbols.Pure.txt, which bans randomness, file, network, environment and process access; the analyzer reads
       every BannedSymbols.*.txt it's given, on top of BannedSymbols.txt. MSBuild evaluates items after every property,
       the project's own included, so this condition sees the .csproj's value though this file is imported first. -->
  <ItemGroup Condition="'$(PureAssembly)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Pure.txt" />
  </ItemGroup>

  <!-- Packages: lock files everywhere, locked restore in CI, and vulnerability audit of direct and transitive packages. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Versioning: MinVer reads the latest vX.Y.Z tag; no build reads a version from a file (SUP-006). -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

</Project>
