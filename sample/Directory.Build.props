<Project>

  <!-- The repo's root settings apply here too. An app gets this file as tests/Directory.Build.props (ADR-0032). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Test projects: xUnit v3 on Microsoft Testing Platform (global.json), with code coverage. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <!-- The kit's shared tests (GAP-037, ADR-0081): tools/AppTests in the kit, .kit/tools/AppTests in an app, where this
       file is tests/Directory.Build.props. An Architecture.Tests project compiles the kit's architecture tests, and
       names the app's assemblies, layer by layer, in its own part of their AppLayers class. A FunctionalTests project
       compiles the kit's host checks, and says how to start the app, and which routes are public, in its own part of
       their AppHost class. -->
  <PropertyGroup>
    <KitAppTests>$(MSBuildThisFileDirectory)../.kit/tools/AppTests/</KitAppTests>
    <KitAppTests Condition="!Exists('$(KitAppTests)')">$(MSBuildThisFileDirectory)../tools/AppTests/</KitAppTests>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Architecture.Tests'))">
    <Compile Include="$(KitAppTests)Architecture/**/*.cs" Link="Kit/Architecture/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.FunctionalTests'))">
    <Compile Include="$(KitAppTests)Functional/**/*.cs" Link="Kit/Functional/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The contract snapshot test finds Contract/<host>/openapi-v1.json here. [CallerFilePath] won't do: CI builds map
         source paths to /_/. -->
    <AssemblyMetadata Include="ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <!-- Benchmarks projects: BenchmarkDotNet console apps, each with a benchmark-budget.json beside it (ADR-0062). Not
       test projects, so dotnet test leaves them alone; the coverage gate and the SBOM leave them out by name. The name
       rule's source is Test-BenchmarksProject in the kit's tools/KitSolution.psm1 (.kit/tools in an app), which the
       coverage gate and SBOM filter use; the kit's tests check the kit's copy of these conditions against it. Change
       the rule in the kit, not here. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Benchmarks'))">
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
