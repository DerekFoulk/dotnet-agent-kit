<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- The contract test finds its snapshot here. [CallerFilePath] won't do: CI builds map source paths to /_/. -->
  <ItemGroup>
    <AssemblyMetadata Include="ProjectDirectory" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

  <!-- Where the API lives, for WebApplicationFactory. Its usual source, MvcTestingAppManifest.json, is read from the
       working directory, and Stryker.NET runs the tests from the repo root (ADR-0039). Key, path, marker, priority. -->
  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryContentRootAttribute">
      <_Parameter1>Bookmarks.Api</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Bookmarks.Api'))</_Parameter2>
      <_Parameter3>Bookmarks.Api.csproj</_Parameter3>
      <_Parameter4>-1</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bookmarks.Api\Bookmarks.Api.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

</Project>
