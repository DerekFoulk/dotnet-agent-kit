<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- dotnet user-jwts keeps its signing key in this project's user secrets, never in the repo (SEC-008). -->
    <UserSecretsId>bookmarks-api-7d1c4b1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bookmarks.Application\Bookmarks.Application.csproj" />
    <ProjectReference Include="..\Bookmarks.Infrastructure\Bookmarks.Infrastructure.csproj" />
    <ProjectReference Include="..\Bookmarks.Contracts\Bookmarks.Contracts.csproj" />
    <ProjectReference Include="..\Bookmarks.ServiceDefaults\Bookmarks.ServiceDefaults.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Only for dotnet ef, which needs it in the startup project (EF Core's migration docs). PrivateAssets keeps it from
         projects that reference the API, but its assemblies, Roslyn's among them, still land in the API's own output
         (ADR-0098 says what would keep them out). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
