  "disableAllHooks": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-File", "${CLAUDE_PROJECT_DIR}/tools/Invoke-CommandGuard.ps1"],
            "timeout": 30
          }
        ]
      }
