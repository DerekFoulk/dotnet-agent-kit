{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet format *)",
      "PowerShell(Invoke-Pester *)",
      "PowerShell(./tools/*)",
      "PowerShell(pwsh -NoProfile -File ./tools/*)",
      "PowerShell(./.kit/tools/*)",
      "PowerShell(pwsh -NoProfile -File ./.kit/tools/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch main)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch main)",
      "PowerShell(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr create *)",
      "mcp__microsoft-learn__*"
    ],
    "ask": [
      "PowerShell(./tools/New-KitApp*)",
      "PowerShell(.\\tools\\New-KitApp*)",
      "PowerShell(pwsh -NoProfile -File ./tools/New-KitApp*)",
      "Bash(pwsh -NoProfile -File ./tools/New-KitApp*)",
      "PowerShell(./tools/Set-AgentMode*)",
      "PowerShell(.\\tools\\Set-AgentMode*)",
      "PowerShell(pwsh -NoProfile -File ./tools/Set-AgentMode*)",
      "Bash(pwsh -NoProfile -File ./tools/Set-AgentMode*)",
      "PowerShell(./.kit/tools/Set-AgentMode*)",
      "PowerShell(.\\.kit\\tools\\Set-AgentMode*)",
      "PowerShell(pwsh -NoProfile -File ./.kit/tools/Set-AgentMode*)",
      "Bash(pwsh -NoProfile -File ./.kit/tools/Set-AgentMode*)",
      "PowerShell(Install-PSResource *)",
      "PowerShell(Install-Module *)",
      "Bash(winget install *)",
      "PowerShell(winget install *)",
      "Bash(*Initialize-DevMachine*-I*)",
      "PowerShell(*Initialize-DevMachine*-I*)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.agent-mode)",
      "Edit(./.mcp.json)",
      "Edit(./.vscode/mcp.json)",
      "Edit(./.kit/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.snk)",
      "Read(~/.ssh/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)"
    ]
  }
}
