{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet format *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(dotnet format *)",
      "PowerShell(Invoke-Pester *)",
      "PowerShell(./tools/*)",
      "PowerShell(pwsh -NoProfile -File ./tools/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr create *)",
      "mcp__microsoft-learn__*"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh repo edit *)",
      "PowerShell(gh repo edit *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "PowerShell(gh api * -X *)",
      "PowerShell(gh api * --method *)",
      "Bash(dotnet add * package *)",
      "PowerShell(dotnet add * package *)",
      "PowerShell(Install-PSResource *)",
      "PowerShell(Install-Module *)",
      "Bash(winget install *)",
      "PowerShell(winget install *)",
      "Bash(*Initialize-DevMachine*-Install*)",
      "PowerShell(*Initialize-DevMachine*-Install*)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git push * --delete *)",
      "PowerShell(git push * --delete *)",
      "Bash(git push * :*)",
      "PowerShell(git push * :*)",
      "Edit(./Directory.Packages.props)",
      "Edit(./Directory.Build.props)",
      "Edit(./nuget.config)",
      "Edit(./global.json)",
      "Edit(./.github/workflows/**)",
      "Edit(./.github/dependabot.yml)",
      "Edit(./.claude/settings.json)",
      "Edit(./.mcp.json)",
      "Edit(./.vscode/mcp.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git * --no-verify*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * main)",
      "PowerShell(git push * HEAD:main)",
      "PowerShell(git * --no-verify*)",
      "Bash(gh pr merge * --admin*)",
      "PowerShell(gh pr merge * --admin*)"
    ]
  }
}
