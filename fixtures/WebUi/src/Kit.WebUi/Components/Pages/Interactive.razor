@page "/interactive"
@rendermode InteractiveServer

<PageTitle>An interactive page</PageTitle>

<main>
    <h1>An interactive page</h1>
    <p>
        This page runs on the server over Blazor's circuit (Interactive Server). The server prerenders it, so the button
        shows before the circuit is up; it stays disabled until then, so no click is lost.
    </p>
    @* Disabled until the component is interactive, as Microsoft's render modes page shows: a click on the prerendered
       button would do nothing, and a test or a person would never know. *@
    <button type="button" @onclick="_clicks.Add" disabled="@(!RendererInfo.IsInteractive)">Add one</button>
    @* role="status" makes a screen reader announce the new count after each click (UI-001). *@
    <p role="status">@_clicks.Status</p>
    <p><a href="">Back to the start</a></p>
</main>

@code {
    private readonly ClickCount _clicks = new();
}
