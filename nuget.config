<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One trusted source; package source mapping stops a package resolving from anywhere else. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- SUP-012: every package must carry a signature from a trusted signer, here nuget.org's repository signature,
       which nuget.org adds to every package it serves. The certificates are the ones nuget.org's service index
       announces; when it rotates them, run `dotnet nuget trust sync nuget.org` and commit the result (ADR-0066).
       <clear /> drops signers trusted by any config above the repo (the user's or the machine's), which NuGet would
       otherwise merge in. .NET checks signatures on Windows and Linux; not on macOS, where Microsoft advises leaving it
       off and the lock files' hashes hold a restore to the verified packages. -->

  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <clear />
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
