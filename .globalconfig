is_global = true

# The analyzer rules that AnalysisLevel latest-all leaves off, turned on here so that every rule is on (STY-003);
# warnings fail the build (STY-004). Microsoft lists eleven of them, the code metric rules and six design rules, and
# calls them all legacy rules that might be deprecated:
#   https://learn.microsoft.com/dotnet/fundamentals/code-analysis/overview#code-quality-analysis  retrieved 2026-11-10
# The SDK's own all-mode file also sets CA1516 to none (sdk/10.0.404/Sdks/Microsoft.NET.Sdk/analyzers/build/config/
# analysislevel_10_all.globalconfig). Each rule below has a fixture in tools/tests/BuildConfig.Tests.ps1. All twelve
# are on.
#
# They live in this file rather than .editorconfig because CA1509, which checks CodeMetricsConfig.txt itself, can only
# be turned on in a global config:
#   https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1509  retrieved 2026-11-10
# A file named .globalconfig applies to every C# project under this folder without being referenced:
#   https://learn.microsoft.com/dotnet/fundamentals/code-analysis/configuration-files#global-analyzerconfig  retrieved 2026-11-10

# Code metrics (CRF-008, ADR-0043). CodeMetricsConfig.txt at the repo root sets their limits.

# CA1501: Avoid excessive inheritance
dotnet_diagnostic.CA1501.severity = warning

# CA1502: Avoid excessive complexity
dotnet_diagnostic.CA1502.severity = warning

# CA1505: Avoid unmaintainable code
dotnet_diagnostic.CA1505.severity = warning

# CA1506: Avoid excessive class coupling
dotnet_diagnostic.CA1506.severity = warning

# CA1509: Invalid entry in code metrics configuration file
dotnet_diagnostic.CA1509.severity = warning

# Legacy design rules (STY-003, ADR-0043).

# CA1005: Avoid excessive parameters on generic types
dotnet_diagnostic.CA1005.severity = warning

# CA1021: Avoid out parameters
dotnet_diagnostic.CA1021.severity = warning

# CA1045: Do not pass types by reference
dotnet_diagnostic.CA1045.severity = warning

# CA1060: Move P/Invokes to NativeMethods class
dotnet_diagnostic.CA1060.severity = warning

# CA1017: Mark assemblies with ComVisible (Directory.Build.props marks every assembly ComVisible(false))
dotnet_diagnostic.CA1017.severity = warning

# CA1014: Mark assemblies with CLSCompliantAttribute (Directory.Build.props marks every assembly CLSCompliant(false);
# ADR-0049)
dotnet_diagnostic.CA1014.severity = warning

# Set to none by the SDK's all-mode file (STY-003, ADR-0043).

# CA1516: Use cross-platform intrinsics
dotnet_diagnostic.CA1516.severity = warning
