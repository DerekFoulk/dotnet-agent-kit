<Project>

  <!-- Central package management: versions live here only; transitive pinning lets this file fix transitive versions too. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Referenced by every project (build-time only, never shipped as a dependency). -->
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" />
    <!-- Bans the APIs in BannedSymbols.txt, such as non-public reflection (CRF-010, ADR-0043). Microsoft's, from dotnet/roslyn. -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Reports async void and async lambdas passed as void delegates, VSTHRD100 and VSTHRD101 only; .editorconfig turns its
         other rules off (STY-011, ADR-0076). Microsoft's, from microsoft/vs-threading. -->
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>

  <!-- Sample app (owner approved, 2026-11-04). The label keeps these out of a new app's copy (ADR-0032). -->
  <ItemGroup Label="Sample app">
    <!-- Authentication (ADR-0048, auto mode): JWT bearer, named by Microsoft's "Configure JWT bearer authentication". -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- The database (GAP-025, ADR-0053, ADR-0054): EF Core's SQL Server provider, and its design-time package, which
         dotnet ef needs in the startup project to scaffold and bundle migrations (DAT-002, DAT-004). Design moves with
         dotnet-ef in .config/dotnet-tools.json (tools/tests/Performance.Tests.ps1 checks they match). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Service defaults (ADR-0037, auto mode): named by Microsoft's health-check and OpenTelemetry docs. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- The sample's integration and functional tests on SQL Server, the engine it runs on (DAT-005, ADR-0054, GAP-025):
         Testcontainers for .NET's SQL Server module (MIT), at Testcontainers' version. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
  </ItemGroup>

  <!-- Kit tools: the kit's own checks, which build with this file: from the kit's download in CI, and from an app's .kit copy on its machine (ADR-0078). The label keeps these out of the app's own copy (ADR-0032). -->
  <ItemGroup Label="Kit tools">
    <!-- Parses and binds C# for the code shape check (CRF-011, ADR-0050): Microsoft's, from dotnet/roslyn. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- Roslyn's other packages at the same version: each requires exactly its own Roslyn version, and EF Core's Design
         package (the sample's) pulls them in, so with CSharp pinned here they're pinned beside it; an app without this
         group gets Design's own, matching set. They move together (dependabot.yml's roslyn group). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
  </ItemGroup>

  <!-- Tests: the kit toolset (TST-005) and Microsoft's test pieces (owner approved, 2026-11-04). -->
  <ItemGroup>
    <!-- Benchmarks with a budget (ADR-0003, ADR-0062). A 0.x package, so its updates are the owner's to merge (ADR-0041). -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Browser and accessibility tests (GAP-004, ADR-0061; named by ADR-0003): Playwright for .NET (MIT), and Deque's axe
         for Playwright (MIT; its axe-core engine, Deque.AxeCore.Commons, is MPL-2.0). -->
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- Containers for tests (ADR-0003, DAT-005): Testcontainers for .NET (MIT). The web UI fixture starts one inside the
         Playwright image, where CI runs it (GAP-047). -->
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
