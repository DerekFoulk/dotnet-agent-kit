# Microsoft .NET code-style baseline (D9).
#
# Sources:
#   https://github.com/dotnet/runtime/blob/860eddba936f4a7e8a04cb12ee3bc54385216cab/.editorconfig  retrieved 2026-11-01
#   https://github.com/dotnet/docs/blob/a9d609595f9b72ac1acd8c60170b92ae3c0644bf/.editorconfig     retrieved 2026-11-01
#
# Based on dotnet/runtime (the newer of the two), with dotnet/docs additions marked "(docs)".
# Every rule Microsoft adopts is raised from suggestion to warning, and TreatWarningsAsErrors makes it
# fail the build. Options Microsoft leaves at silent, none or refactoring stay that way: no preference.
# Deviations from the sources are marked "(kit)". New exceptions need an ADR.
#
# Left out (repo-specific to dotnet/runtime): the .NET Foundation file header, xUnit1051, the CA2025
# workaround for one runtime file, and the IDE0031/IDE0071 netstandard workarounds.
#
# Both sources are MIT-licensed (for dotnet/docs, its code license); their notices are in
# THIRD-PARTY-NOTICES.md, which travels with this file.

root = true

# Default settings
[*]
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# UTF-8 without byte-order mark
[*.{csproj,locproj,nativeproj,proj,resx,slnx,vbproj}]
charset = utf-8

# C# files
[*.cs]
# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Modifier preferences
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning

# Avoid this. unless absolutely necessary
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Types: use keywords instead of BCL types.
# (kit) STY-002: var only where the type is named on the right side (a new, a cast), as in dotnet/runtime's own
# .editorconfig, which leaves that case to the author (false:none); everywhere else the type is written, and the kit
# enforces that at warning where the runtime only suggests it (owner, 2026-11-12; earlier, 2026-10-27: never var).
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:none
csharp_style_var_elsewhere = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# (kit) STY-007: Microsoft's identifier names page. Types, namespaces, members (methods, properties, events) and
# local functions are PascalCase; parameters and locals are camelCase; local constants are PascalCase. The field
# rules below come first in this file but are more specific, so they win for fields.
dotnet_naming_rule.types_and_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_and_members_should_be_pascal_case.symbols  = types_and_members
dotnet_naming_rule.types_and_members_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, interface, enum, delegate, method, property, event, local_function
dotnet_naming_rule.local_constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.local_constants_should_be_pascal_case.symbols  = local_constants
dotnet_naming_rule.local_constants_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.local_constants.applicable_kinds = local
dotnet_naming_symbols.local_constants.required_modifiers = const
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.symbols  = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_should_be_camel_case.style    = camel_case_style
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_style.camel_case_style.capitalization = camel_case
# The build reports naming rules only at IDE1006's own severity; a rule's severity line alone stays in the editor.
dotnet_diagnostic.IDE1006.severity = warning

# Name all constant fields using PascalCase
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols  = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.constant_fields.applicable_kinds   = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# (kit) STY-014: a static readonly field that isn't private is PascalCase, as a public one is in the Framework Design
# Guidelines. CA1707 fails an underscore in a static readonly field, and it checks internal APIs here (STY-009), so the
# s_ prefix the identifier names page gives an internal static field can't build on a readonly one. An internal static
# field that isn't readonly keeps s_, since CA1707 doesn't check it; CA1051 fails a visible instance field. A naming
# rule with more modifiers comes first, so this one wins over the s_ rule below.
# https://learn.microsoft.com/dotnet/standard/design-guidelines/names-of-type-members#names-of-fields  retrieved 2026-11-16
dotnet_naming_rule.visible_static_readonly_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.visible_static_readonly_fields_should_be_pascal_case.symbols  = visible_static_readonly_fields
dotnet_naming_rule.visible_static_readonly_fields_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.visible_static_readonly_fields.applicable_kinds   = field
dotnet_naming_symbols.visible_static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.visible_static_readonly_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

# Static fields have an s_ prefix
dotnet_naming_rule.static_fields_should_have_prefix.severity = warning
dotnet_naming_rule.static_fields_should_have_prefix.symbols  = static_fields
dotnet_naming_rule.static_fields_should_have_prefix.style    = static_prefix_style
dotnet_naming_symbols.static_fields.applicable_kinds   = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.static_prefix_style.required_prefix = s_
dotnet_naming_style.static_prefix_style.capitalization = camel_case

# Internal and private fields are _camelCase
dotnet_naming_rule.camel_case_for_private_internal_fields.severity = warning
dotnet_naming_rule.camel_case_for_private_internal_fields.symbols  = private_internal_fields
dotnet_naming_rule.camel_case_for_private_internal_fields.style    = camel_case_underscore_style
dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

# Code style defaults
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:silent
csharp_preserve_single_line_blocks = true:none
csharp_preserve_single_line_statements = false:none
csharp_prefer_static_local_function = true:warning
# (kit) STY-007: Microsoft's C# coding conventions prefer simple using declarations; dotnet/runtime leaves it off.
csharp_prefer_simple_using_statement = true:warning
# (kit) STY-007: target-typed new() where the type is apparent, and primary constructors (C# coding conventions).
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
csharp_style_prefer_primary_constructors = true:warning
csharp_style_prefer_switch_expression = true:warning
dotnet_style_readonly_field = true:warning
# (kit) STY-009: Framework Design Guidelines, "DO NOT define mutable value types": a struct whose members are all
# read-only is declared readonly (IDE0250).
csharp_style_prefer_readonly_struct = true:warning
# (docs): the next two come from dotnet/docs, not dotnet/runtime
dotnet_code_quality_unused_parameters = non_public:warning
csharp_style_namespace_declarations = file_scoped:warning

# Expression-level preferences
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
# (kit) STY-007: collection expressions for every collection type, as the C# coding conventions ask.
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
# (kit) STY-007: parentheses wherever operators of different precedence meet, for clarity (IDE0047, IDE0048).
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
csharp_prefer_simple_default_expression = true:warning

# Expression-bodied members
csharp_style_expression_bodied_methods = true:silent
csharp_style_expression_bodied_constructors = true:silent
csharp_style_expression_bodied_operators = true:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent
csharp_style_expression_bodied_local_functions = true:silent

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_inlined_variable_declaration = true:warning

# Null checking preferences
csharp_style_throw_expression = true:warning
csharp_style_conditional_delegate_call = true:warning

# Other features
csharp_style_prefer_index_operator = false:none
csharp_style_prefer_range_operator = false:none
csharp_style_pattern_local_over_anonymous_function = false:none

# Space preferences
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# (kit) STY-009, ADR-0070: the Design, Naming and Usage rules check internal APIs too, not only public and protected
# ones (their api_surface default), so they reach an app, whose types CA1515 makes internal. Set per category, never
# for all rules: CA1822, CA1802 and CA1859 have their own scope, and CA1859 asks non-public code for concrete types.
# Private members are left out: the guidelines are about a type's API. A category setting replaces each rule's own
# default, so the two rules in these categories whose default is every member, private included (CA1068 and CA2208, in
# the analyzers' source), keep it by rule ID; a rule's own setting wins over its category's.
# https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-quality-rule-options#api_surface
dotnet_code_quality.Design.api_surface = public, internal
dotnet_code_quality.Naming.api_surface = public, internal
dotnet_code_quality.Usage.api_surface = public, internal
dotnet_code_quality.CA1068.api_surface = all
dotnet_code_quality.CA2208.api_surface = all
# CA1815 (override Equals on value types) and CA1819 (properties don't return arrays) are Performance rules.
dotnet_code_quality.CA1815.api_surface = public, internal
dotnet_code_quality.CA1819.api_surface = public, internal

# (kit) STY-007: Microsoft's managed threading page: a dedicated System.Threading.Lock with the lock statement (.NET 9+).
csharp_prefer_system_threading_lock = true:warning
dotnet_diagnostic.IDE0330.severity = warning

# (kit) STY-011, ADR-0076: Microsoft.VisualStudio.Threading.Analyzers is here for VSTHRD100 (async void), VSTHRD101 (an
# async lambda passed as a void delegate), VSTHRD107 (a using statement over a Task, which disposes the task instead of
# awaiting it) and VSTHRD110 (a Task dropped in a method that isn't async, where CS4014 doesn't look), as the owner chose
# (2026-11-16; the last two closed GAP-045). Of its other rules, most concern Visual Studio's JoinableTaskFactory; some
# repeat a rule the kit already has from one source (CRF-003): VSTHRD002 is BannedSymbols.txt's (STY-011), VSTHRD103
# CA1849's, VSTHRD105 CA2008's, VSTHRD111 CA2007's and VSTHRD200 the Async suffix, which stays advisory (STY-007).
# https://github.com/microsoft/vs-threading/tree/main/docfx/analyzers  retrieved 2026-11-16
dotnet_diagnostic.VSTHRD001.severity = none
dotnet_diagnostic.VSTHRD002.severity = none
dotnet_diagnostic.VSTHRD003.severity = none
dotnet_diagnostic.VSTHRD004.severity = none
dotnet_diagnostic.VSTHRD010.severity = none
dotnet_diagnostic.VSTHRD011.severity = none
dotnet_diagnostic.VSTHRD012.severity = none
dotnet_diagnostic.VSTHRD013.severity = none
dotnet_diagnostic.VSTHRD102.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.VSTHRD104.severity = none
dotnet_diagnostic.VSTHRD105.severity = none
dotnet_diagnostic.VSTHRD106.severity = none
dotnet_diagnostic.VSTHRD108.severity = none
dotnet_diagnostic.VSTHRD109.severity = none
dotnet_diagnostic.VSTHRD111.severity = none
dotnet_diagnostic.VSTHRD112.severity = none
dotnet_diagnostic.VSTHRD113.severity = none
dotnet_diagnostic.VSTHRD114.severity = none
dotnet_diagnostic.VSTHRD115.severity = none
dotnet_diagnostic.VSTHRD116.severity = none
dotnet_diagnostic.VSTHRD117.severity = none
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.VSTHRD202.severity = none
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD107.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning

# (kit) ADR-0029: CA2007 (ConfigureAwait) applies to class libraries only. Microsoft advises suppressing it
# for application code: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca2007
dotnet_code_quality.CA2007.output_kind = DynamicallyLinkedLibrary

# (kit) ADR-0029: test projects are libraries too, but they're application code for CA2007's purposes.
[{*Tests/**.cs,**/*Tests/**.cs}]
dotnet_diagnostic.CA2007.severity = none

# (kit) ADR-0062: BenchmarkDotNet runs only public, unsealed benchmark classes, and CA1515 asks an app (a benchmarks
# project is an Exe) to make its public types internal. Off in benchmarks projects (names ending in .Benchmarks) only.
# The name rule's source is Test-BenchmarksProject in the kit's tools/KitSolution.psm1 (.kit/tools in an app), which the
# coverage gate and SBOM filter use; the kit's tests check the kit's copy of this section against it. Change it there.
[{*.Benchmarks/**.cs,**/*.Benchmarks/**.cs}]
dotnet_diagnostic.CA1515.severity = none

# (kit) GAP-025: EF Core's migrations, which dotnet ef migrations add writes in its own style (a block namespace, array
# arguments, no null check), and which are read but not rewritten (DAT-017). Analyzers skip generated code, so this
# marks them generated, as EF marks a migration's Designer file and the model snapshot <auto-generated />:
# https://learn.microsoft.com/dotnet/fundamentals/code-analysis/configuration-options#exclude-generated-code. The code shape
# check knows the same folder (tools/CodeShape, EfCoreMigrations).
[{Migrations/**.cs,**/Migrations/**.cs}]
generated_code = true

# XML project and build files
[*.{csproj,vbproj,proj,nativeproj,locproj,props,targets,config,nuspec}]
indent_size = 2

# XML files
[*.{resx,ruleset,slnx,xml}]
indent_size = 2

# XML resource files: match Visual Studio behavior
[*.resx]
insert_final_newline = false
trim_trailing_whitespace = false

# Data serialization
[*.{json,yaml,yml}]
indent_size = 2

# Markdown (docs): double trailing spaces can be line breaks
[*.md]
trim_trailing_whitespace = false

# Scripts
[*.sh]
end_of_line = lf
[*.{cmd,bat}]
end_of_line = crlf
